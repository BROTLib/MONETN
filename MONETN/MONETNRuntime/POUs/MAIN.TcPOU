<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MAIN" Id="{0fe844df-7078-44d3-bc48-268e6c994874}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	ready				: BOOL;		// power monitoring phaseOK (published as electronics/base/MainReady)
	mainReady			: BOOL;		// what gates the power-on (bMainReady): phaseOK without the L3 voltage guard WARNING, see below
	error				: BOOL;		// error stat on drive, power or hydraulics
	brakeClearing		: BOOL := FALSE;	//	open brake
	
	commTimer 			: TON := (PT:=T#5S);
	getHostName			: FB_GetHostName;
	hostName			: STRING(255);
	executeHostName		: BOOL := TRUE;
	
	eTelescopeMode 		: E_TelescopeMode;
	
	fbComm				: FB_Comm_MQTT_Influx;
	SafetyHandling		: FB_MonetSafetyHandling(comm := fbComm);
	CabinetControl		: FB_MonetCabinetControl(comm := fbComm);
	PowerMonitoring		: FB_MonetPowerMonitoring(comm := fbComm);
	RoofControl			: FB_RoofControl(comm := fbComm);
	CoverControl		: HalfBROT.FB_CoverControl(comm := fbComm);	// mirror covers (HalfBROT; was MONETcommon FB_MonetCoverControl)
	HydraulicsControl	: FB_HydraulicsControl(comm := fbComm);
	FocusControl		: FB_FocusControl(comm := fbComm);
	DerotatorControl	: FB_DerotatorControl(comm := fbComm);
	ElevationControl	: FB_ElevationControl(comm := fbComm);
	AzimuthControl		: FB_AzimuthControl(comm := fbComm);
	TelescopeControl	: FB_MonetTelescopeControl(comm := fbComm);
	PendantControl		: FB_MonetPendantControl(comm := fbComm);
	TelescopeAuxiliary	: FB_MonetnTelescopeAuxiliary(comm := fbComm);	// mirror temperatures M1/M2
	MqttWatchdog		: FB_MonetMqttWatchdog(comm := fbComm);	// park + close roof after 30 s without broker (MONETcommon)
	// MONETcommon#24 step 7 (D9): close the roof on TelescopeControl.bCloseRoofRequest (serious errors) in automatic mode.
	// TRUE = enabled; set FALSE via ADS for test runs. Not persistent: back to TRUE at every PLC start (the safe default).
	bRoofCloseOnErrorEnable	: BOOL := TRUE;
	Diagnostics			: FB_MonetDiagnostics(comm := fbComm);	// diagnostics/base/* telemetry, on change + 30 s heartbeat (MONETcommon)

	// MONETcommon#24 step 5: Power/Park/Slew/Goto switches of the Telescope Visu (pattern of MONETS#72). The Visu sets the bit, the
	// body calls the method and clears the bit. The Visu must not write bPower/bPark/bSlew/bGoto: they become edge-triggered inputs.
	bVisuTelescopePower	: BOOL;	// Init()
	bVisuTelescopePark	: BOOL;	// Park()
	bVisuTelescopeSlew	: BOOL;	// Slew() to the fAzimuth/fElevation the Visu wrote
	bVisuTelescopeGoto	: BOOL;	// Track() to the fRightAscension/fDeclination the Visu wrote (sets bGoto, like bGoto did)

	// MONETS#72: Start buttons of the axis Visus. The Visu sets the bit, the body starts the homing through the HomeAxis property
	// (the focus through bManualHome, HalfBROT#138) and clears the bit. The Visu must not write bHomeAxis: that sets the level only and no homing starts.
	bVisuHomeElevation	: BOOL;
	bVisuHomeAzimuth	: BOOL;
	bVisuHomeDerotator	: BOOL;
	bVisuHomeFocus		: BOOL;

	// HalfBROT#31: switches of the Visus that used to write inputs of the HalfBROT blocks. The blocks keep those request flags in VAR,
	// so the Visu sets a variable here and the body calls the block (see the two sections around the scan).
	// Switches that show a state (enable, move) follow the block at the end of the scan; push buttons are cleared by the body.
	bVisuHydraulicsEnable	: BOOL;		// HydraulicsControl.Enable
	bVisuHydraulicsReset	: BOOL;		// HydraulicsControl.Reset()
	bVisuBrakeClose			: BOOL;		// HydraulicsControl.CloseBrake()
	bVisuBrakeOpen			: BOOL;		// shows HydraulicsControl.BrakeOpen only: the brake is opened by the cabinet switch (brakeClearing)
	bVisuMoveAzimuth		: BOOL;		// AzimuthControl.MoveAxis
	bVisuMoveElevation		: BOOL;		// ElevationControl.MoveAxis
	bVisuMoveDerotator		: BOOL;		// DerotatorControl.MoveAxis
END_VAR
VAR CONSTANT
	// MONETS#32: raw counts of the oil level sensor (same Reventec LS as MONET/S): below the limit is a cut wire, lost supply or the sensor error output (about 330); above is over-range. Measured on MONET/N 2026-10-27: the oversized pan is never drained completely (bottom 1100..1300, 821 at a pump start), the pan-full float switch trips at raw ~9520..9550; the limits lie between those and the sensor extremes, as on MONET/S (MONETS#58)
	nOilLevelMinValid	: INT := 450;
	nOilLevelMaxValid	: INT := 12000;
	telescopeConfig		: ST_TelescopeConfig := (longitude := -104.0217, latitude := 30.6714, altitude := 2000.0, 
												 azimuthPark := 190, elevationPark := 60, derotatorPark := -116.42, focusPark := 53.8, 
												 azimuthHome := 190, elevationHome := 40, derotatorHome := -116.42,
												 name := 'MONET/N', diameter := 1.2, cabinet := 'Beckhoff', manufacturer := 'Halfmann, Haidenhain, Beckhoff',
												 mountOptions := 'ALT-AZ', mount := 'ALT_AZ');
	// MONET/N pointing model, moved here from its former local copy of FB_MonetTelescopeControl (same coefficients)
	fbPointing			: FB_PointingModelForward(AOFF := 0.0, BNP := 0.41799581014823517, AN_A := -0.0005399238415356825, AE_A := 0.0010943700155200701, NPAE := 0.3540915955287274,
                                                  EOFF := 0.0, AN_E := -0.0015387935505830619, AE_E := 0.0028384915610841777, TF := 0.07539398326327973);
	fbPointingInverse	: FB_PointingModelInversion(fbPointing := fbPointing);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* 
Main control loop
* Execute sub modules
* power management
* control panel switches and status lamps

* start switch activates Hydraulics and Trafo
* 
*)

// get hostname for MQTT connection
GetHostName(bExecute := executeHostName, sHostName => HostName);
executeHostName := FALSE;

// Visu switches of the HalfBROT blocks (HalfBROT#31). First in the scan: a state switch differs from the block only when the
// operator changed it since the end of the last scan (see the end of this program), so a change by the block is never written back.
IF bVisuHydraulicsEnable <> HydraulicsControl.Enable THEN
	HydraulicsControl.Enable := bVisuHydraulicsEnable;
END_IF
IF bVisuHydraulicsReset THEN
	bVisuHydraulicsReset := FALSE;
	HydraulicsControl.Reset();
END_IF
IF bVisuBrakeClose THEN
	bVisuBrakeClose := FALSE;
	HydraulicsControl.CloseBrake();
END_IF
IF bVisuMoveAzimuth <> AzimuthControl.MoveAxis THEN
	AzimuthControl.MoveAxis := bVisuMoveAzimuth;
END_IF
IF bVisuMoveElevation <> ElevationControl.MoveAxis THEN
	ElevationControl.MoveAxis := bVisuMoveElevation;
END_IF
IF bVisuMoveDerotator <> DerotatorControl.MoveAxis THEN
	DerotatorControl.MoveAxis := bVisuMoveDerotator;
END_IF

// run cabinet
CabinetControl(iTelescope := TelescopeControl);	// parks the telescope while the cabinet is too hot (MONETcommon#32)

// telescope mode
IF CabinetControl.KeyLocal THEN
	eTelescopeMode := SEL(HydraulicsControl.Enable, E_TelescopeMode.off, E_TelescopeMode.manual);	
ELSE
	eTelescopeMode := E_TelescopeMode.automatic; 
END_IF

// in local mode we can start or stop hydraulics and open the brake
brakeClearing := TRUE;
IF eTelescopeMode = E_TelescopeMode.manual OR eTelescopeMode = E_TelescopeMode.off THEN
	IF CabinetControl.IsStartPushed() THEN
		HydraulicsControl.Enable := TRUE;
	END_IF
	IF CabinetControl.IsStopPushed() THEN
		HydraulicsControl.Enable := FALSE;
	END_IF
	brakeClearing := CabinetControl.AreBreakesCleared();
	HydraulicsControl.ManualBrake(brakeClearing);	// HalfBROT#31: one open request per rising edge of the switch, no re-open after the brake dropped
END_IF

// clear errors: SafetyHandling.resetRequest (see call below) toggles Restart/ErrAck,
// here the cabinet/pendant reset button also resets covers, hydraulics and, in automatic mode, the
// telescope control (the only way to clear a latched bInterrupted)
IF CabinetControl.IsResetPushed() OR PendantControl.IbResetButton THEN
	CoverControl.Reset();
	HydraulicsControl.Reset();
	IF eTelescopeMode = E_TelescopeMode.automatic THEN
		TelescopeControl.Reset();
	END_IF
END_IF

// Telescope Visu switches (MONETcommon#24 step 5): one method call per click, like an MQTT command. The targets are the
// inputs the Visu text fields write; the method writes them back unchanged (or nothing if it rejects the move).
IF bVisuTelescopePower THEN
	bVisuTelescopePower := FALSE;
	TelescopeControl.Init();
END_IF
IF bVisuTelescopePark THEN
	bVisuTelescopePark := FALSE;
	TelescopeControl.Park();
END_IF
IF bVisuTelescopeSlew THEN
	bVisuTelescopeSlew := FALSE;
	TelescopeControl.Slew(fAzimuth := TelescopeControl.fAzimuth, fAltitude := TelescopeControl.fElevation);
END_IF
IF bVisuTelescopeGoto THEN
	bVisuTelescopeGoto := FALSE;
	TelescopeControl.Track(fRightAscension := TelescopeControl.fRightAscension, fDeclination := TelescopeControl.fDeclination);
END_IF

// Visu Start buttons (MONETS#72): HomeAxis starts the homing on its rising edge, a direct write of bHomeAxis would not
IF bVisuHomeElevation THEN
	bVisuHomeElevation := FALSE;
	ElevationControl.HomeAxis := TRUE;
END_IF
IF bVisuHomeAzimuth THEN
	bVisuHomeAzimuth := FALSE;
	AzimuthControl.HomeAxis := TRUE;
END_IF
IF bVisuHomeDerotator THEN
	bVisuHomeDerotator := FALSE;
	DerotatorControl.HomeAxis := TRUE;
END_IF
IF bVisuHomeFocus THEN
	bVisuHomeFocus := FALSE;
	FocusControl.ManualHome();	// HalfBROT#138: cam homing, calibrated or not; HomeAxis is a no-op on a calibrated focus.
	// The result (refusal reason, e.g. manual mode) is FocusControl.eManualHome.
END_IF

// telescope is ready when power available
PowerMonitoring(phaseOK => ready);

// The L3 voltage guard WARNING (EL3483) has been TRUE on MONET/N all along (seen 2026-10-27 before the update, nothing
// used it). Wiring bMainReady (MONETcommon#11) made it block every power-on, so the power-on ignores that one warning
// for now. The L3 voltage guard ERROR and every other power guard still block. TODO: find out why L3 warns (real
// undervoltage or a threshold in the EL3483 settings), then use `ready` again. `ready` itself, and so the MainReady
// telemetry, is unchanged and still shows the warning.
mainReady := NOT PowerMonitoring.FrequencyGuardWarning AND NOT PowerMonitoring.FrequencyGuardError AND
	NOT PowerMonitoring.QualityGuardWarning AND NOT PowerMonitoring.QualityGuardError AND
	NOT PowerMonitoring.UnbalanceGuardWarning AND NOT PowerMonitoring.UnbalanceGuardError AND
	NOT PowerMonitoring.L1VoltageGuardWarning AND NOT PowerMonitoring.L1VoltageGuardError AND
	NOT PowerMonitoring.L2VoltageGuardWarning AND NOT PowerMonitoring.L2VoltageGuardError AND
	NOT PowerMonitoring.L3VoltageGuardError;

// only run TelescopeControl in automatic mode
IF eTelescopeMode = E_TelescopeMode.automatic THEN
	TelescopeControl(
		telescopeConfig := telescopeConfig,
		fbCovers 		:= CoverControl,
		fbBrake 		:= HydraulicsControl,
		fbHydraulics 	:= HydraulicsControl,
		fbFocus 		:= FocusControl,
		fbElevation 	:= ElevationControl,
		fbAzimuth 		:= AzimuthControl,
		fbDerotator 	:= DerotatorControl,
		fbPointing      := fbPointing,
		fbPointingInverse := fbPointingInverse,
		bEstopTriggered := SafetyHandling.estop,	// M5: was never wired, see MONETcommon#11
		bSafetyError	:= SafetyHandling.error,		// MONETcommon#155: closes the brake opened in the Wake&Shake window; FALSE = not enforced
		bMainReady		:= mainReady				// M5: was computed and published but never wired, see MONETcommon#11 (without the L3 warning, see above)
	);
ELSE
    // Invalidate startup readiness and publish its heartbeat without running automatic motion in manual mode.
    // MONETcommon#168: E-stop, safety error and power failure reach the manual READY_STATE (telemetry only, no axis write).
    TelescopeControl.SuspendAutomatic(
        bEstopIn		:= SafetyHandling.estop,
        bSafetyErrorIn	:= SafetyHandling.error,
        bMainReadyIn	:= mainReady);
END_IF
TelescopeAuxiliary();

// run all control FBs
CoverControl(
	stIn	:= GVL_IO.stCoverIn,
	stOut	:= GVL_IO.stCoverOut
);
HydraulicsControl(
	stIn			:= GVL_IO.stHydraulicsIn,
	stOut			:= GVL_IO.stHydraulicsOut,
	nMinPanLevel	:= 900,		// empty pan reads raw ~1100..1300 with suction (measured 2026-10-27)
	nMaxPanLevel	:= 9400,	// the pan-full float switch trips at raw ~9520..9550 (100 %)
	fMinPanPercent	:= 15.0,	// suction stops at raw ~2175 (was raw 3000, 0.0 % with 3000..10200)
	fMaxPanPercent	:= 70.0,	// suction starts at raw ~6850 (was 50.0 with 3000..10200, raw ~6600)
	nMinValidPanLevel	:= nOilLevelMinValid,	// outside this raw range the level is not published and does not start/stop the suction (HalfBROT 0.5.6)
	nMaxValidPanLevel	:= nOilLevelMaxValid,
	bBrakeClearing	:= brakeClearing
);
ElevationControl(
	stIn			:= GVL_IO.stElevationIn,
	fCalibPosition 	:= 25.8657627917962052,
	fbCovers 		:= CoverControl, 
	fbBrake 		:= HydraulicsControl
);
AzimuthControl(
	stIn			:= GVL_IO.stAzimuthIn,
	fCalibPosition	:=  211.355503610763347,
	fMinPosition	:= -72.0,
	fMaxPosition	:= 495.0,
	bBrakeOpen		:= HydraulicsControl.brakeOpen,
);
DerotatorControl(
	stIn			:= GVL_IO.stDerotatorIn,
	fMinPosition		:= -170.0,
	fMaxPosition		:= 300.0
);	//
FocusControl(
	stIn			:= GVL_IO.stFocusIn,
	stOut			:= GVL_IO.stFocusOut,
	eTelescopeMode 	:= eTelescopeMode,
	fHomingPosition	:= 92.02, // 104.02 - 12.00
	// limit switches at 0 and fHomingPosition; targets stay 0.5 mm inside (MONETcommon#122)
	fMinPosition	:= 0.5,
	fMaxPosition	:= 91.5,
	fVelocity		:= 0.2
);
RoofControl(
	min_speed		:= 10000,
	max_speed 		:= 30000, 
	acceleration 	:= 150,
	min_position_1 	:= 0,
	max_position_1 	:= 202,
	min_position_2 	:= 0,
	max_position_2 	:= 202,
	max_position_diff	:= 3,
	limit_slowdown	:= 5
);
PendantControl(
	eTelescopeMode	:= eTelescopeMode,	// MONETcommon#177: unwired it is off; the pendant gates on it from MONETcommon 0.18.0
	fbCovers 		:= CoverControl,
	fbFocus 		:= FocusControl,
	fbElevation 	:= ElevationControl, 
	fbAzimuth 		:= AzimuthControl, 
	fbDerotator 	:= DerotatorControl	
);

// broker gone for 30 s: park the telescope and close the roof (armed after the first connect)
MqttWatchdog(bConnected := fbComm.bConnected, iTelescope := TelescopeControl, iRoof := RoofControl);

// Roof close on serious telescope errors (MONETcommon#24 step 7, D9): axis error, hydraulics error, E-stop, safety error,
// power failure. TelescopeControl.bCloseRoofRequest is latched in MONETcommon and cleared by a telescope reset once no cause
// is active. Only in automatic mode (cabinet selector), the same condition as the TelescopeControl call above, and only
// while bRoofCloseOnErrorEnable. Called every scan while requested, like the watchdog: Close() only sets the roof target
// speed (nothing when already closed), so repeating it is harmless, and it re-issues the close after a roof reset.
// E-stop: the E-stop circuit also cuts the roof drives, so the close cannot act during the E-stop; the request stays
// latched and the close takes effect after the release and restart of the roof drives (a roof error latched meanwhile
// needs a roof reset first).
// Power failure here means NOT mainReady (the bMainReady of the TelescopeControl call, without the L3 warning, see above).
IF bRoofCloseOnErrorEnable AND eTelescopeMode = E_TelescopeMode.automatic AND TelescopeControl.bCloseRoofRequest THEN
	RoofControl.Close();
END_IF

// Visu switches follow the blocks (HalfBROT#31), last in the scan: the next scan applies only what the operator changed.
bVisuHydraulicsEnable := HydraulicsControl.Enable;
bVisuBrakeOpen := HydraulicsControl.BrakeOpen;
bVisuMoveAzimuth := AzimuthControl.MoveAxis;
bVisuMoveElevation := ElevationControl.MoveAxis;
bVisuMoveDerotator := DerotatorControl.MoveAxis;

// and fbComm
fbComm(
	sHostName		:= '169.254.146.10',
    nHostPort  		:= 1883,
    nKeepAlive  	:= 60,
	sTopicSub  		:= 'MONETN/Telescope/SET',
	sTopicPublish	:= 'MONETN/Telemetry',
	sTopicLog		:= 'MONETN/Log',
	Telescope		:= TelescopeControl,
	AltAzTelescope  := TelescopeControl,
	Focus			:= FocusControl,
	Roof			:= RoofControl
);

// set control lights
//error := Focuscontrol.Error OR CoverControl.Error OR HydraulicsControl.Error;
error := CoverControl.Error OR HydraulicsControl.Error;
CabinetControl.SetManualLamp(eTelescopeMode = E_TelescopeMode.manual);

// blink errors
IF SafetyHandling.error THEN
	CabinetControl.SetBlinkError(E_Blink.short);
ELSIF ElevationControl.bError OR AzimuthControl.bError OR DerotatorControl.bError THEN
	CabinetControl.SetBlinkError(E_Blink.long);
ELSIF HydraulicsControl.bOilWarning OR HydraulicsControl.bOilHot OR HydraulicsControl.bPressureFailure OR HydraulicsControl.bOilLevelInvalid THEN
	CabinetControl.SetBlinkError(E_Blink.slow);
ELSIF error THEN
	CabinetControl.SetBlinkError(E_Blink.on);
ELSE
	CabinetControl.SetBlinkError(E_Blink.off); 
END_IF

// power lamp is always on
CabinetControl.SetBlinkPower(E_Blink.on);

// do safety
SafetyHandling(resetRequest := CabinetControl.IsResetPushed() OR PendantControl.IbResetButton);

// telemetry
commTimer(IN:=TRUE);
IF commTimer.Q THEN
	commTimer(IN:=FALSE);
	fbComm.PublishBOOL('electronics', 'base', 'MainReady', ready);
	fbComm.PublishBOOL('electronics', 'base', 'MasterError', error);
	TelescopeAuxiliary.SendTelemetry();
END_IF

// diagnostics telemetry: publish on change, plus a full-snapshot heartbeat (MONETcommon)
Diagnostics(
	fbTelescope	:= TelescopeControl,
	fbElevation	:= ElevationControl,
	fbAzimuth	:= AzimuthControl,
	fbDerotator	:= DerotatorControl,
	fbFocus		:= FocusControl,
	fbSafety	:= SafetyHandling
);

]]></ST>
    </Implementation>
